# ================================================
# 环境变量配置模板
# 复制此文件为 .env 并填入实际值后使用
# ================================================

# 硅基流动API配置
SILICON_FLOW_API_KEY = ""
SILICON_FLOW_API_BASE = "https://api.siliconflow.cn/v1"

# 硅基流动模型配置
EMBEDDING_MODEL = "Qwen/Qwen3-Embedding-0.6B"
#LLM_MODEL = "deepseek-ai/DeepSeek-V3.2"
#LLM_MODEL_LARGE = "Qwen/Qwen3.5-27B"
#LLM_MODEL_SMALL = "Qwen/Qwen3.5-9B"

# deepseek模型配置
deepseek_API_KEY = ""
deepseek_API_BASE = "https://api.deepseek.com"
LLM_MODEL = "deepseek-v4-flash"


# 小米 API 配置（可选）
xiaomi_API_KEY = "your_xiaomi_api_key_here"
xiaomi_API_BASE = "https://token-plan-cn.xiaomimimo.com/v1"

# PDF OCR 默认语言
PDF_OCR_LANG = "chi_sim+eng"

# PDF OCR 开关（默认开启：图片 OCR / 扫描版整页 OCR）
PDF_OCR_IMAGES = "true"
PDF_OCR_FULL_PAGE = "true"

# Tesseract OCR 安装路径
# Windows 可使用仓库内置的 OCR 目录（注意：内置 tessdata 只有 eng / osd，中文需补 chi_sim.traineddata）
# 示例：TESSERACT_CMD = "D:\\Python_exercise\\项目1-RAG_Agent\\大赛项目最终版\\OCR\\tesseract.exe"
TESSERACT_CMD = ""


# LibreOffice 安装路径（用于 .doc 老格式转换，可选）
# Windows 示例：C:\Program Files\LibreOffice\program\soffice.exe
# 留空则自动从默认路径检测；Docker 镜像内已安装 libreoffice-writer
LIBREOFFICE_PATH = ""

# JWT 签名密钥（生产环境务必改成随机长字符串，至少 32 位）
JWT_SECRET_KEY = "change-me-to-a-random-secret-at-least-32-chars"

# ================================================
# 检索参数（可选，留空使用代码默认值）
# ================================================
RETRIEVAL_TOP_K = "80"
RETRIEVAL_NPROBE = "16"
RETRIEVAL_THRESHOLD = "0.3"
LLM_TEMPERATURE = "0.0"

# ================================================
# 数据库连接（本地开发保持 localhost；Docker Compose 会在容器内覆盖为服务名）
# ================================================
# Milvus 向量数据库连接
MILVUS_HOST = "localhost"
MILVUS_PORT = "19530"

# PostgreSQL 数据库连接
POSTGRES_HOST = "localhost"
POSTGRES_PORT = "5432"
POSTGRES_USER = "omnipilot"
POSTGRES_PASSWORD = "omnipilot123"
POSTGRES_DB = "omnipilot"